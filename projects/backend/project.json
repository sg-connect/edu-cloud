{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "projects/backend",
  "tags": ["layer:backend"],
  "implicitDependencies": ["database"],
  "targets": {
    "build": {
      "command": "wrangler deploy --config wrangler.backend.jsonc --dry-run --outdir projects/backend/dist",
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "command": "tsc --noEmit -p projects/backend/tsconfig.json"
    },
    "test": {
      "command": "vitest run --config vitest.config.ts tests/backend.test.ts"
    }
  }
}
